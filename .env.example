# Environment configuration for Rainfall Explorer

# API Configuration
VITE_API_BASE_URL=https://environment.data.gov.uk/flood-monitoring

# Cache Configuration (in days)
VITE_CACHE_EXPIRY_DAYS=7

# Poll Interval (in milliseconds)
VITE_POLL_INTERVAL_MS=30000

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ARCHIVE_IMPORT=true

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
